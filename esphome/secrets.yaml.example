# =============================================================================
# 复制本文件为 secrets.yaml 后填写。secrets.yaml 不要提交/外传。
# ESPHome 编译器只读 secrets.yaml，本 .example 只是模板。
# =============================================================================

# ── WiFi：必须是 2.4GHz（ESP32 不支持 5GHz）────────────────────────────────
wifi_ssid: "我的WiFi"
wifi_password: "WiFi密码"

# ── HA API 加密密钥：32 字节的 base64 字符串 ────────────────────────────────
# 任选一种方式生成：
#   1) HA 的 ESPHome Device Builder 插件里点 "Generate encryption key"，直接复制；
#   2) 任意 Linux/WSL/Git Bash：openssl rand -base64 32
#   3) 本机 PowerShell：见 README §3 的一行命令
# 首次在 HA 添加该设备时，HA 会让你粘贴同一个密钥。
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# ── OTA 密码：可以随便自定，刷过一次 OTA 后就要用它 ─────────────────────────
ota_pw: "change-me-1234"
